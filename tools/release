#!/bin/sh
# Build one installable package for each supported Minecraft version.
set -eu
cd "$(dirname "$0")/.."
mod=$(sed -n 's/^mod_version=//p' gradle.properties)
[ -n "$mod" ] || { echo "No mod_version in gradle.properties" >&2; exit 1; }
./gradlew :26.2:build :26.3:build :fpshud:build -q --console=plain
for mc in 26.2 26.3; do
    version=$mod+mc$mc
    jar=versions/$mc/build/libs/mcopt-metal-$version.jar
    name=mcopt-$version
    mkdir -p "dist/$name"
    if [ "$mc" = 26.3 ]; then
        python3 tools/bundle.py --metal "$jar" --fps "fpshud/build/libs/fpshud-$mod.jar" --out "dist/$name.jar"
    else
        cp "$jar" "dist/$name.jar"
    fi
    cp "dist/$name.jar" "dist/$name/$name.jar"
    cp LICENSE NOTICE "dist/$name/"
    if [ "$mc" = 26.2 ]; then
        cp -R LICENSES "dist/$name/"
        sed -e "s/@VERSION@/$version/g" -e "s/@MC@/$mc/g" versions/26.2/RELEASE-README.txt > "dist/$name/README.txt"
    else
        sed "s/@VERSION@/$version/g" RELEASE-README.txt > "dist/$name/README.txt"
    fi
    rm -f "dist/$name.zip"
    (cd dist && zip -qrX "$name.zip" "$name")
    echo "dist/$name.jar"
done
